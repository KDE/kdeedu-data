  <identifiers>
    <identifier id="0" >
      <locale>eu</locale>
    </identifier>
  </identifiers>
  <entries>
    <entry id="0" >
      <inactive>true</inactive>
      <inquery>false</inquery>
      <translation id="0" >
        <text>telebista</text>
        <comment>mugitzen diren irudiak erakusten dituen gailu elektrikoa</comment>
      </translation>
    </entry>
    <entry id="1" >
      <inactive>true</inactive>
      <inquery>false</inquery>
      <translation id="0" >
        <text>aulkia</text>
        <comment>eserita egoteko altzaria</comment>
      </translation>
    </entry>
    <entry id="2" >
      <inactive>true</inactive>
      <inquery>false</inquery>
      <translation id="0" >
        <text>izozkailua</text>
        <comment>janaria oso hotz eta izoztuta edukitzeko etxetresna</comment>
      </translation>
    </entry>
    <entry id="3" >
      <inactive>true</inactive>
      <inquery>false</inquery>
      <translation id="0" >
        <text>hozkailua</text>
        <comment>janaria fresko edukitzeko etxetresna</comment>
      </translation>
    </entry>
    <entry id="4" >
      <inactive>true</inactive>
      <inquery>false</inquery>
      <translation id="0" >
        <text>sukaldea</text>
        <comment>janaria beroaren bidez prestatzeko etxetresna</comment>
      </translation>
    </entry>
    <entry id="5" >
      <inactive>true</inactive>
      <inquery>false</inquery>
      <translation id="0" >
        <text>tximinia</text>
        <comment>eguraldi hotzean suaren bidez berotzeko egitura</comment>
      </translation>
    </entry>
    <entry id="6" >
      <inactive>true</inactive>
      <inquery>false</inquery>
      <translation id="0" >
        <text>mahaia</text>
        <comment>objektuak lurretik gora eusten dituen gainazal laua</comment>
      </translation>
    </entry>
    <entry id="7" >
      <inactive>true</inactive>
      <inquery>false</inquery>
      <translation id="0" >
        <text>tiraderak</text>
        <comment>gauza txikiak gordetzeko kutxa lerragarriak</comment>
      </translation>
    </entry>
    <entry id="8" >
      <inactive>true</inactive>
      <inquery>false</inquery>
      <translation id="0" >
        <text>ispilua</text>
        <comment>aurrean duenaren irudia islatzen du</comment>
      </translation>
    </entry>
    <entry id="9" >
      <inactive>true</inactive>
      <inquery>false</inquery>
      <translation id="0" >
        <text>erlojua</text>
        <comment>ordua neurtu eta erakusten du</comment>
      </translation>
    </entry>
    <entry id="10" >
      <inactive>true</inactive>
      <inquery>false</inquery>
      <translation id="0" >
        <text>armairua</text>
        <comment>jantziak zintzilik eta tente gordetzeko altzaria</comment>
      </translation>
    </entry>
    <entry id="11" >
      <inactive>true</inactive>
      <inquery>false</inquery>
      <translation id="0" >
